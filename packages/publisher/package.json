{
  "name": "@forma/publisher",
  "version": "0.0.1",
  "description": "Core library for publishing Markdown to Confluence",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "confluence",
    "markdown",
    "publisher"
  ],
  "author": "James Maes",
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  }
}
